rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isActiveUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function ownsDriverData() {
      return isActiveUser()
        && request.resource.data.driverId == request.auth.uid;
    }

    function ownedExistingDriverData() {
      return isActiveUser()
        && resource.data.driverId == request.auth.uid;
    }

    function ownsRoute(routeId) {
      return isActiveUser()
        && routeId is string
        && exists(/databases/$(database)/documents/routes/$(routeId))
        && get(/databases/$(database)/documents/routes/$(routeId)).data.driverId == request.auth.uid;
    }

    function validRouteStatus(status) {
      return status in ['draft', 'planned', 'assigned', 'in_progress', 'completed', 'cancelled'];
    }

    function validDeliveryStatus(status) {
      return status in ['pending', 'in_route', 'arrived', 'delivered', 'not_delivered', 'cancelled'];
    }

    function validDriverRouteTransition(previousStatus, nextStatus) {
      return previousStatus == nextStatus
        || (previousStatus == 'assigned' && nextStatus == 'in_progress')
        || (previousStatus == 'in_progress' && nextStatus == 'completed');
    }

    function validDriverDeliveryTransition(previousStatus, nextStatus) {
      return previousStatus == nextStatus
        || (previousStatus == 'pending' && nextStatus == 'in_route')
        || (previousStatus == 'in_route' && nextStatus in ['arrived', 'not_delivered'])
        || (previousStatus == 'arrived' && nextStatus in ['delivered', 'not_delivered']);
    }

    function validAddress(data) {
      return data is map
        && data.keys().hasAll(['formattedAddress', 'latitude', 'longitude'])
        && data.formattedAddress is string
        && data.latitude is number
        && data.latitude >= -90
        && data.latitude <= 90
        && data.longitude is number
        && data.longitude >= -180
        && data.longitude <= 180;
    }

    function validGeoLocation(data) {
      return data is map
        && data.keys().hasAll(['latitude', 'longitude'])
        && data.latitude is number
        && data.latitude >= -90
        && data.latitude <= 90
        && data.longitude is number
        && data.longitude >= -180
        && data.longitude <= 180
        && (!('recordedAt' in data) || data.recordedAt is timestamp);
    }

    function validProofRequirements(data) {
      return data is map
        && data.keys().hasAll([
          'requirePhoto',
          'requireReceiverName',
          'requireReceiverDocument',
          'requireSignature',
          'requireLocation'
        ])
        && data.requirePhoto is bool
        && data.requireReceiverName is bool
        && data.requireReceiverDocument is bool
        && data.requireSignature is bool
        && data.requireLocation is bool;
    }

    function validRouteData(data, routeId) {
      return data.keys().hasAll([
          'id',
          'code',
          'serviceDate',
          'status',
          'driverId',
          'driverName',
          'vehicleId',
          'vehiclePlate',
          'startAddress',
          'endAddress',
          'deliveryCount',
          'completedDeliveryCount',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && data.id == routeId
        && data.code is string
        && data.code.size() > 0
        && data.serviceDate is timestamp
        && validRouteStatus(data.status)
        && data.driverId is string
        && data.driverName is string
        && data.vehicleId is string
        && data.vehiclePlate is string
        && validAddress(data.startAddress)
        && validAddress(data.endAddress)
        && data.deliveryCount is int
        && data.deliveryCount >= 0
        && data.completedDeliveryCount is int
        && data.completedDeliveryCount >= 0
        && data.completedDeliveryCount <= data.deliveryCount
        && data.createdAt is timestamp
        && data.createdBy is string
        && data.updatedAt is timestamp
        && data.updatedBy is string
        && (!('currentLocation' in data) || validGeoLocation(data.currentLocation))
        && (!('startedAt' in data) || data.startedAt == null || data.startedAt is timestamp)
        && (!('completedAt' in data) || data.completedAt == null || data.completedAt is timestamp);
    }

    function validDeliveryData(data, deliveryId) {
      return data.keys().hasAll([
          'id',
          'routeId',
          'orderNumber',
          'clientName',
          'driverId',
          'driverName',
          'vehicleId',
          'vehiclePlate',
          'sequence',
          'status',
          'address',
          'scheduledAt',
          'proofRequirements',
          'proofStatus',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && data.id == deliveryId
        && data.routeId is string
        && data.orderNumber is string
        && data.orderNumber.size() > 0
        && data.clientName is string
        && data.driverId is string
        && data.driverName is string
        && data.vehicleId is string
        && data.vehiclePlate is string
        && data.sequence is int
        && data.sequence >= 0
        && validDeliveryStatus(data.status)
        && validAddress(data.address)
        && data.scheduledAt is timestamp
        && validProofRequirements(data.proofRequirements)
        && data.proofStatus in ['pending', 'submitted', 'approved', 'rejected']
        && data.createdAt is timestamp
        && data.createdBy is string
        && data.updatedAt is timestamp
        && data.updatedBy is string
        && (!('checkInLocation' in data) || validGeoLocation(data.checkInLocation))
        && (!('arrivedAt' in data) || data.arrivedAt == null || data.arrivedAt is timestamp)
        && (!('deliveredAt' in data) || data.deliveredAt == null || data.deliveredAt is timestamp);
    }

    function validRouteEventData(data, eventId) {
      return data.keys().hasAll([
          'id',
          'routeId',
          'deliveryId',
          'driverId',
          'vehicleId',
          'type',
          'source',
          'actorId',
          'occurredAt',
          'createdAt'
        ])
        && data.id == eventId
        && data.routeId is string
        && data.routeId.size() > 0
        && data.deliveryId is string
        && data.driverId is string
        && data.vehicleId is string
        && data.type in [
          'route_created',
          'route_assigned',
          'route_started',
          'route_completed',
          'route_cancelled',
          'delivery_check_in',
          'delivery_completed',
          'delivery_failed',
          'delivery_cancelled',
          'delivery_proof_submitted',
          'delivery_proof_approved',
          'delivery_proof_rejected',
          'status_changed',
          'note_added'
        ]
        && data.source in ['admin', 'driver', 'system']
        && data.actorId is string
        && data.occurredAt is timestamp
        && data.createdAt is timestamp;
    }

    function deliveryBelongsToRoute(deliveryId, routeId) {
      return deliveryId == '' || (
        exists(/databases/$(database)/documents/deliveries/$(deliveryId))
        && get(/databases/$(database)/documents/deliveries/$(deliveryId)).data.routeId == routeId
        && get(/databases/$(database)/documents/deliveries/$(deliveryId)).data.driverId == request.auth.uid
      );
    }

    function ownsDelivery(deliveryId) {
      return isActiveUser()
        && deliveryId is string
        && deliveryId.size() > 0
        && exists(/databases/$(database)/documents/deliveries/$(deliveryId))
        && get(/databases/$(database)/documents/deliveries/$(deliveryId)).data.driverId == request.auth.uid;
    }

    function validDeliveryReceiptData(data, receiptId) {
      return data.keys().hasAll([
          'id',
          'deliveryId',
          'routeId',
          'orderNumber',
          'clientId',
          'clientName',
          'driverId',
          'driverName',
          'vehicleId',
          'vehiclePlate',
          'cteAccessKey',
          'cteNumber',
          'receiverName',
          'receiverDocument',
          'location',
          'physicalProofPhotoUrls',
          'pendingPhysicalProofLocalPaths',
          'declaration',
          'adminStatus',
          'createdAt'
        ])
        && data.id == receiptId
        && data.deliveryId is string
        && data.deliveryId.size() > 0
        && data.routeId is string
        && data.orderNumber is string
        && data.orderNumber.size() > 0
        && data.clientId is string
        && data.clientName is string
        && data.driverId is string
        && data.driverName is string
        && data.vehicleId is string
        && data.vehiclePlate is string
        && data.cteAccessKey is string
        && data.cteAccessKey.size() == 44
        && data.cteNumber is string
        && data.receiverName is string
        && data.receiverName.size() > 0
        && data.receiverDocument is string
        && data.receiverDocument.size() > 0
        && validGeoLocation(data.location)
        && data.physicalProofPhotoUrls is list
        && data.pendingPhysicalProofLocalPaths is list
        && data.physicalProofPhotoUrls.size() + data.pendingPhysicalProofLocalPaths.size() > 0
        && data.declaration is string
        && data.adminStatus == 'pending'
        && data.createdAt is timestamp;
    }

    function receiptMatchesDelivery(data, receiptId) {
      return ownsDelivery(data.deliveryId)
        && get(/databases/$(database)/documents/deliveries/$(data.deliveryId)).data.status != 'cancelled'
        && get(/databases/$(database)/documents/deliveries/$(data.deliveryId)).data.proofStatus in ['pending', 'rejected']
        && get(/databases/$(database)/documents/deliveries/$(data.deliveryId)).data.routeId == data.routeId
        && get(/databases/$(database)/documents/deliveries/$(data.deliveryId)).data.orderNumber == data.orderNumber
        && get(/databases/$(database)/documents/deliveries/$(data.deliveryId)).data.driverId == data.driverId
        && get(/databases/$(database)/documents/deliveries/$(data.deliveryId)).data.vehicleId == data.vehicleId
        && (
          !('cteAccessKey' in get(/databases/$(database)/documents/deliveries/$(data.deliveryId)).data)
          || get(/databases/$(database)/documents/deliveries/$(data.deliveryId)).data.cteAccessKey == ''
          || get(/databases/$(database)/documents/deliveries/$(data.deliveryId)).data.cteAccessKey == data.cteAccessKey
        )
        && getAfter(/databases/$(database)/documents/deliveries/$(data.deliveryId)).data.proofStatus == 'submitted'
        && getAfter(/databases/$(database)/documents/deliveries/$(data.deliveryId)).data.deliveryProofId == receiptId;
    }

    function validSetting(data, settingId) {
      return data.id == settingId
        && data.kind == settingId
        && settingId in ['delivery', 'routes', 'permissions', 'imports']
        && data.version is int
        && data.version > 0
        && data.updatedAt is timestamp
        && data.updatedBy is string
        && (
          (
            settingId == 'delivery'
            && data.keys().hasAll([
              'checkInRadiusMeters',
              'defaultProofRequirements',
              'failureReasons',
              'statusTransitions'
            ])
            && data.checkInRadiusMeters is int
            && data.checkInRadiusMeters > 0
            && validProofRequirements(data.defaultProofRequirements)
            && data.failureReasons is list
            && data.statusTransitions is map
          )
          || (
            settingId == 'routes'
            && data.keys().hasAll([
              'gpsUpdateIntervalSeconds',
              'gpsOfflineAfterSeconds',
              'allowDriverReorderStops',
              'allowRouteEditAfterStart',
              'statusTransitions'
            ])
            && data.gpsUpdateIntervalSeconds is int
            && data.gpsUpdateIntervalSeconds > 0
            && data.gpsOfflineAfterSeconds is int
            && data.gpsOfflineAfterSeconds >= data.gpsUpdateIntervalSeconds
            && data.allowDriverReorderStops is bool
            && data.allowRouteEditAfterStart is bool
            && data.statusTransitions is map
          )
          || (
            settingId == 'permissions'
            && data.keys().hasAll(['rolePermissions'])
            && data.rolePermissions is map
          )
          || (
            settingId == 'imports'
            && data.keys().hasAll([
              'maxRows',
              'requiredColumns',
              'duplicateKey',
              'allowPartialImport'
            ])
            && data.maxRows is int
            && data.maxRows > 0
            && data.requiredColumns is list
            && data.duplicateKey is string
            && data.allowPartialImport is bool
          )
        );
    }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && uid == request.auth.uid);
      allow update: if isAdmin() || (
        signedIn()
        && uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'photoUrl'])
      );
      allow create, delete: if isAdmin();
    }

    match /vehicles/{vehicleId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    match /trips/{tripId} {
      allow read: if isAdmin() || ownedExistingDriverData();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        ownedExistingDriverData()
        && request.resource.data.driverId == resource.data.driverId
        && request.resource.data.vehicleId == resource.data.vehicleId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'startedAt',
          'completedAt',
          'deliveryDocs',
          'programmingStatus',
          'operationalStatus',
          'operationType',
          'statusUpdatedAt',
          'gpsLocation',
          'lastGpsUpdateAt'
        ])
      );
    }

    match /routes/{routeId} {
      allow read: if isAdmin() || ownedExistingDriverData();
      allow create: if isAdmin() && validRouteData(request.resource.data, routeId);
      allow update: if (
        isAdmin()
        && validRouteData(request.resource.data, routeId)
      ) || (
        ownedExistingDriverData()
        && request.resource.data.driverId == resource.data.driverId
        && request.resource.data.vehicleId == resource.data.vehicleId
        && request.resource.data.updatedBy == request.auth.uid
        && validRouteData(request.resource.data, routeId)
        && validDriverRouteTransition(resource.data.status, request.resource.data.status)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'currentLocation',
          'startedAt',
          'completedAt',
          'completedDeliveryCount',
          'actualDistanceMeters',
          'actualDurationSeconds',
          'updatedAt',
          'updatedBy'
        ])
      );
      allow delete: if isAdmin();
    }

    match /deliveries/{deliveryId} {
      allow read: if isAdmin() || ownedExistingDriverData();
      allow create: if isAdmin() && validDeliveryData(request.resource.data, deliveryId);
      allow update: if (
        isAdmin()
        && validDeliveryData(request.resource.data, deliveryId)
      ) || (
        ownedExistingDriverData()
        && request.resource.data.driverId == resource.data.driverId
        && request.resource.data.routeId == resource.data.routeId
        && request.resource.data.vehicleId == resource.data.vehicleId
        && request.resource.data.updatedBy == request.auth.uid
        && validDeliveryData(request.resource.data, deliveryId)
        && validDriverDeliveryTransition(resource.data.status, request.resource.data.status)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'arrivedAt',
          'deliveredAt',
          'checkInLocation',
          'failure',
          'proofStatus',
          'deliveryProofId',
          'notes',
          'updatedAt',
          'updatedBy'
        ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'proofStatus',
            'deliveryProofId'
          ])
          || (
            resource.data.proofStatus in ['pending', 'rejected']
            && request.resource.data.proofStatus == 'submitted'
            && request.resource.data.deliveryProofId is string
            && request.resource.data.deliveryProofId.size() > 0
          )
        )
      );
      allow delete: if isAdmin();
    }

    match /routeEvents/{eventId} {
      allow read: if isAdmin() || (
        isActiveUser()
        && resource.data.driverId == request.auth.uid
      );
      allow create: if validRouteEventData(request.resource.data, eventId) && (
        isAdmin()
        || (
          isActiveUser()
          && request.resource.data.source == 'driver'
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.driverId == request.auth.uid
          && !(request.resource.data.type in ['delivery_proof_approved', 'delivery_proof_rejected'])
          && ownsRoute(request.resource.data.routeId)
          && deliveryBelongsToRoute(request.resource.data.deliveryId, request.resource.data.routeId)
        )
      );
      allow update, delete: if false;
    }

    match /settings/{settingId} {
      allow read: if isAdmin() || (
        isActiveUser()
        && settingId in ['delivery', 'routes']
      );
      allow create, update: if isAdmin()
        && validSetting(request.resource.data, settingId);
      allow delete: if false;
    }

    match /checklists/{checklistId} {
      allow read: if isAdmin() || ownedExistingDriverData();
      allow create: if isAdmin() || ownsDriverData();
      allow update: if isAdmin() || (
        ownedExistingDriverData()
        && request.resource.data.driverId == resource.data.driverId
        && request.resource.data.tripId == resource.data.tripId
        && request.resource.data.vehicleId == resource.data.vehicleId
      );
      allow delete: if isAdmin();
    }

    match /incidents/{incidentId} {
      allow read: if isAdmin() || ownedExistingDriverData();
      allow create: if isAdmin() || ownsDriverData();
      allow update: if isAdmin() || (
        ownedExistingDriverData()
        && request.resource.data.driverId == resource.data.driverId
        && request.resource.data.tripId == resource.data.tripId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'description',
          'cost',
          'photoUrl',
          'pendingPhotoLocalPath'
        ])
      );
      allow delete: if isAdmin();
    }

    match /deliveryReceipts/{receiptId} {
      allow read: if isAdmin() || ownedExistingDriverData();
      allow create: if isAdmin() || (
        ownsDriverData()
        && validDeliveryReceiptData(request.resource.data, receiptId)
        && receiptMatchesDelivery(request.resource.data, receiptId)
      );
      allow update: if isAdmin() || (
        ownedExistingDriverData()
        && request.resource.data.driverId == resource.data.driverId
        && request.resource.data.deliveryId == resource.data.deliveryId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'physicalProofPhotoUrls',
          'pendingPhysicalProofLocalPaths'
        ])
      );
      allow delete: if isAdmin();
    }

    match /fuelingRecords/{fuelingRecordId} {
      allow read: if isAdmin() || ownedExistingDriverData();
      allow create: if isAdmin() || ownsDriverData();
      allow update: if isAdmin() || (
        ownedExistingDriverData()
        && request.resource.data.driverId == resource.data.driverId
      );
      allow delete: if isAdmin();
    }

    match /driverEquipments/{equipmentId} {
      allow read: if isAdmin() || ownedExistingDriverData();
      allow write: if isAdmin();
    }
  }
}
