rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    match /drivers/{driverId}/{allPaths=**} {
      allow read: if isAdmin() || (signedIn() && driverId == request.auth.uid);
      allow write: if isAdmin() || (
        signedIn()
        && driverId == request.auth.uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
      );
    }

    match /trips/{tripId}/cte/{fileName} {
      allow read: if isAdmin() || (
        signedIn()
        && firestore.exists(/databases/(default)/documents/trips/$(tripId))
        && firestore.get(/databases/(default)/documents/trips/$(tripId)).data.driverId == request.auth.uid
      );
      allow create, update: if isAdmin()
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if isAdmin();
    }
  }
}
